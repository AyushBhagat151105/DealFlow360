generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum ProductCategory {
  HARDWARE
  SERVICE
  SUBSCRIPTION
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  UNDER_NEGOTIATION
  CONFIRMED
  REJECTED
  FULFILLED
}

enum ApprovalLevel {
  NONE
  SALES_MANAGER
  FINANCE
}

enum ApprovalAction {
  SUBMIT
  APPROVE_MANAGER
  APPROVE_FINANCE
  REJECT
  RETURN_FOR_REVISION
  CUSTOMER_COUNTER
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InvoiceType {
  ONE_TIME
  RECURRING
  PRORATED_SUPPLEMENTAL
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum AnomalyType {
  STALLED_DEAL
  DISCOUNT_ANOMALY
  DELIVERY_SLIPPAGE
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

model Customer {
  id                    String       @id @default(cuid())
  name                  String
  contactName           String
  email                 String       @unique
  phone                 String?
  address               String?
  tier                  CustomerTier @default(BRONZE)
  historicalAvgDiscount Float        @default(0.0)
  portalPassword        String?
  portalAccessToken     String?      @unique @default(cuid())
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  quotes    Quotation[]
  contracts SubscriptionContract[]
  invoices  Invoice[]

  @@index([email])
  @@index([tier])
  @@map("customer")
}

model CustomerTierConfig {
  id                     String       @id @default(cuid())
  tier                   CustomerTier @unique
  defaultDiscountCeiling Float
  description            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@map("customer_tier_config")
}

model CategoryDiscountCeiling {
  id                 String          @id @default(cuid())
  category           ProductCategory @unique
  maxDiscountCeiling Float
  description        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("category_discount_ceiling")
}

model Product {
  id                 String          @id @default(cuid())
  sku                String          @unique
  name               String
  description        String?
  category           ProductCategory
  unit               String          @default("unit")
  costPrice          Float
  basePrice          Float
  taxRate            Float           @default(10.0)
  isPromoted         Boolean         @default(false)
  minMarginThreshold Float           @default(15.0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  variants        ProductVariant[]
  stocks          WarehouseStock[]
  quoteLines      QuotationLine[]
  upsellRulesFrom UpsellRule[]     @relation("sourceProduct")
  upsellRulesTo   UpsellRule[]     @relation("suggestedProduct")

  @@index([sku])
  @@index([category])
  @@map("product")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String
  value      String
  extraPrice Float    @default(0.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stocks     WarehouseStock[]
  quoteLines QuotationLine[]

  @@index([productId])
  @@map("product_variant")
}

model UpsellRule {
  id                 String   @id @default(cuid())
  sourceProductId    String
  sourceProduct      Product  @relation("sourceProduct", fields: [sourceProductId], references: [id], onDelete: Cascade)
  suggestedProductId String
  suggestedProduct   Product  @relation("suggestedProduct", fields: [suggestedProductId], references: [id], onDelete: Cascade)
  pairingWeight      Float    @default(1.0)
  promotionTag       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([sourceProductId])
  @@index([suggestedProductId])
  @@map("upsell_rule")
}

model Warehouse {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  location           String?
  shippingCostWeight Float    @default(1.0)
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stocks            WarehouseStock[]
  fulfillmentSplits FulfillmentSplit[]

  @@map("warehouse")
}

model WarehouseStock {
  id               String          @id @default(cuid())
  warehouseId      String
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantityOnHand   Int             @default(0)
  reservedQuantity Int             @default(0)
  reorderThreshold Int             @default(5)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([warehouseId, productId, variantId])
  @@index([warehouseId])
  @@index([productId])
  @@map("warehouse_stock")
}

model Quotation {
  id                    String          @id @default(cuid())
  quoteNumber           String          @unique
  customerId            String
  customer              Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  repUserId             String?
  status                QuotationStatus @default(DRAFT)
  totalAmount           Float           @default(0.0)
  totalCost             Float           @default(0.0)
  totalMarginPercent    Float           @default(0.0)
  blendedRiskScore      Float           @default(0.0)
  requiredApprovalLevel ApprovalLevel   @default(NONE)
  currentApprovalStep   String?
  portalAccessToken     String          @unique @default(cuid())
  notes                 String?
  deliveryPromiseDate   DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  lines                 QuotationLine[]
  auditLogs             ApprovalAuditLog[]
  fulfillmentSplits     FulfillmentSplit[]
  invoices              Invoice[]
  subscriptionContracts SubscriptionContract[]
  negotiationComments   NegotiationComment[]
  dealAlerts            DealAnomalyAlert[]

  @@index([customerId])
  @@index([status])
  @@index([repUserId])
  @@index([portalAccessToken])
  @@map("quotation")
}

model QuotationLine {
  id                     String            @id @default(cuid())
  quotationId            String
  quotation              Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId              String
  product                Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId              String?
  variant                ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  subscriptionPlanId     String?
  subscriptionPlan       SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  quantity               Int               @default(1)
  unitPrice              Float
  unitCost               Float
  discountPercent        Float             @default(0.0)
  effectivePrice         Float
  subtotal               Float
  totalCost              Float
  marginPercent          Float
  categoryCeilingPercent Float
  lineExcessPercent      Float             @default(0.0)
  customerComment        String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  comments          NegotiationComment[]
  fulfillmentSplits FulfillmentSplit[]

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_line")
}

model ApprovalAuditLog {
  id               String         @id @default(cuid())
  quotationId      String
  quotation        Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  action           ApprovalAction
  actorName        String
  actorRole        String?
  blendedRiskScore Float?
  reason           String?
  metadata         Json?
  createdAt        DateTime       @default(now())

  @@index([quotationId])
  @@map("approval_audit_log")
}

model NegotiationComment {
  id                      String         @id @default(cuid())
  quotationId             String
  quotation               Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationLineId         String?
  quotationLine           QuotationLine? @relation(fields: [quotationLineId], references: [id], onDelete: Cascade)
  authorName              String
  isCustomer              Boolean        @default(true)
  comment                 String
  proposedDiscountPercent Float?
  createdAt               DateTime       @default(now())

  @@index([quotationId])
  @@index([quotationLineId])
  @@map("negotiation_comment")
}

model FulfillmentSplit {
  id                    String         @id @default(cuid())
  quotationId           String
  quotation             Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationLineId       String?
  quotationLine         QuotationLine? @relation(fields: [quotationLineId], references: [id], onDelete: Cascade)
  warehouseId           String?
  warehouse             Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  quantityAllocated     Int            @default(0)
  quantityBackordered   Int            @default(0)
  status                String         @default("ALLOCATED")
  estimatedShippingCost Float          @default(0.0)
  isManualOverride      Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([quotationId])
  @@index([warehouseId])
  @@map("fulfillment_split")
}

model SubscriptionPlan {
  id                       String          @id @default(cuid())
  name                     String
  code                     String          @unique
  interval                 BillingInterval @default(MONTHLY)
  unitPrice                Float
  prorationMethod          String          @default("DAILY")
  cancellationRefundPolicy String          @default("PRO_RATA_CREDIT")
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  contracts  SubscriptionContract[]
  quoteLines QuotationLine[]

  @@map("subscription_plan")
}

model SubscriptionContract {
  id                 String           @id @default(cuid())
  contractNumber     String           @unique
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotationId        String?
  quotation          Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  seats              Int              @default(1)
  unitPrice          Float
  recurringAmount    Float
  status             String           @default("ACTIVE")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  schedules SubscriptionBillingSchedule[]
  invoices  Invoice[]

  @@index([customerId])
  @@index([quotationId])
  @@map("subscription_contract")
}

model SubscriptionBillingSchedule {
  id          String               @id @default(cuid())
  contractId  String
  contract    SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  billingDate DateTime
  amount      Float
  status      String               @default("PENDING")
  createdAt   DateTime             @default(now())

  @@index([contractId])
  @@map("subscription_billing_schedule")
}

model Invoice {
  id            String                @id @default(cuid())
  invoiceNumber String                @unique
  customerId    String
  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotationId   String?
  quotation     Quotation?            @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  contractId    String?
  contract      SubscriptionContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  type          InvoiceType           @default(ONE_TIME)
  status        InvoiceStatus         @default(ISSUED)
  amount        Float
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  lines    InvoiceLine[]
  payments PaymentRecord[]

  @@index([customerId])
  @@index([quotationId])
  @@index([status])
  @@map("invoice")
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  amount      Float
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_line")
}

model PaymentRecord {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String
  reference     String?
  paidAt        DateTime @default(now())

  @@index([invoiceId])
  @@map("payment_record")
}

model DealAnomalyAlert {
  id          String          @id @default(cuid())
  quotationId String
  quotation   Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  type        AnomalyType
  severity    AnomalySeverity @default(MEDIUM)
  message     String
  metricDelta Float?
  isDismissed Boolean         @default(false)
  isNudged    Boolean         @default(false)
  isEscalated Boolean         @default(false)
  escalatedTo String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([quotationId])
  @@index([type])
  @@map("deal_anomaly_alert")
}
