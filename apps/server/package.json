{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "seed": "bun --env-file=.env src/scripts/seed.ts",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@DealFlow360/auth": "workspace:*",
    "@DealFlow360/db": "workspace:*",
    "@DealFlow360/env": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "@react-email/components": "^1.0.12",
    "@scalar/hono-api-reference": "^0.12.0",
    "@scalar/openapi-to-markdown": "^0.5.43",
    "better-auth": "catalog:",
    "bullmq": "^5.81.2",
    "cloudinary": "^2.10.1",
    "dodopayments": "catalog:",
    "dotenv": "catalog:",
    "hono": "^4.12.27",
    "react": "catalog:",
    "react-email": "^6.9.2",
    "resend": "^6.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@DealFlow360/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}